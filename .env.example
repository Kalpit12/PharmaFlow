# Copy to `.env` locally. Never commit real credentials.
# On Vercel: Project → Settings → Environment Variables (Production + Preview).

# PostgreSQL (Neon, Supabase, Vercel Postgres, etc.). Use a pooled URL for serverless if your provider offers one.
DATABASE_URL="postgresql://pharmora:pharmora@localhost:5432/pharmora?schema=public"

# Auth.js session secret (generate a long random string). Required in production.
AUTH_SECRET=""

# Optional on Vercel when using a custom domain (auth.config uses trustHost). Example:
# AUTH_URL="https://pharmaflow.vercel.app"

# Development seed credentials only. Do not use a real password.
AUTH_DEV_EMAIL="alex@medicrest.demo"
AUTH_DEV_PASSWORD="pharmora-demo-local"

# Server-only OpenAI (never NEXT_PUBLIC_).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Use AI_PROVIDER=mock to keep the Phase 5B demo adapter (no model calls).
AI_PROVIDER="openai"
